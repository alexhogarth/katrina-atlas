@inject LocationStore Store
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="atlas @(panelOpen ? "panel-open" : "panel-closed") @(exportPreset is not null ? "atlas-exporting" : null)">
    <WorldMap @ref="map"
              Locations="locations"
              Draft="draft"
              Theme="theme"
              Settings="mapSettings"
              PickMode="pickMode"
              SelectedId="selectedId"
              IsLoaded="loaded"
              ObstructionSelector=".atlas-panel"
              OnMapClick="HandleMapClickAsync"
              OnDraftMoved="HandleDraftMovedAsync"
              OnMarkerClick="HandleMarkerClickAsync" />

    <MapSettingsMenu Settings="mapSettings" OnChanged="SaveMapSettingsAsync" OnExport="StartExportAsync" />

    @if (exportPreset is not null)
    {
        <ExportBar Preset="exportPreset"
                   Busy="exporting"
                   Message="@exportMessage"
                   CenterLongitude="mapSettings.ExportCenterLongitude"
                   OnCenterChanged="ChangeExportCenterAsync"
                   OnPresetChanged="ChangeExportPresetAsync"
                   OnFit="FitExportAsync"
                   OnDownload="DownloadPngAsync"
                   OnCancel="EndExportAsync" />
    }

    <button type="button" class="atlas-panel-toggle" @onclick="TogglePanel"
            aria-label="@(panelOpen ? "Hide places panel" : "Show places panel")" aria-expanded="@panelOpen">
        @(panelOpen ? "›" : "‹")
    </button>

    @if (pickMode)
    {
        <div class="atlas-pick-banner" role="status">
            Click anywhere on the map to drop the pin
            <button type="button" @onclick="() => pickMode = false">Cancel</button>
        </div>
    }

    <aside class="atlas-panel" aria-label="Places">
        <header class="atlas-panel-header">
            <div class="atlas-brand">
                <span class="atlas-brand-mark"><MarkerPreview Style="brandStyle" IdPrefix="brand" /></span>
                <div>
                    <h1>Katrina's Atlas</h1>
                    <p>@Summary</p>
                </div>
            </div>
            <div class="atlas-theme-switch" role="radiogroup" aria-label="Theme">
                @foreach (var (value, label, water, land) in Themes)
                {
                    <button type="button" role="radio" aria-checked="@(theme == value)" title="@label" aria-label="@label"
                            class="@(theme == value ? "active" : null)" style="--sw-water: @water; --sw-land: @land"
                            @onclick="() => SetThemeAsync(value)"></button>
                }
            </div>
        </header>

        <div class="atlas-panel-body">
            @if (!loaded)
            {
                <p class="atlas-hint p-3">Loading your places…</p>
            }
            else if (draft is not null)
            {
                <LocationEditor @ref="editor"
                                @key="draft"
                                Draft="draft"
                                LabelsHidden="!mapSettings.ShowPlaceLabels"
                                @bind-PickMode="pickMode"
                                OnChanged="StateHasChanged"
                                OnFlyTo="FlyToAsync"
                                OnSave="SaveDraftAsync"
                                OnCancel="CancelDraft"
                                OnDelete="DeleteDraftAsync" />
            }
            else
            {
                <div class="atlas-list-actions">
                    <button type="button" class="btn atlas-btn-primary w-100" @onclick="StartAdd">＋ Add a place</button>
                    @if (locations.Count > 1)
                    {
                        <button type="button" class="btn atlas-btn-ghost" title="Show all places" @onclick="FitAllAsync">⤢</button>
                    }
                </div>
                <LocationList Locations="locations"
                              SelectedId="selectedId"
                              OnSelect="SelectAsync"
                              OnEdit="StartEdit"
                              OnDelete="DeleteAsync" />
            }
        </div>
    </aside>
</div>

@code {
    // Swatch colours match the basemap palettes in worldMap.js.
    private static readonly (MapTheme Value, string Label, string Water, string Land)[] Themes =
    [
        (MapTheme.Light, "Light", "#c6d3dd", "#eceae6"),
        (MapTheme.Sand, "Sand", "#c9d8d5", "#f3ebdd"),
        (MapTheme.Emerald, "Emerald", "#11523f", "#3daa87"),
        (MapTheme.Dark, "Dark", "#18191c", "#2e2f33"),
        (MapTheme.Navy, "Navy (deep blue)", "#051c2c", "#123653"),
        (MapTheme.Blue, "Blue (brighter navy)", "#0b3d6e", "#24609a"),
        (MapTheme.Midnight, "Midnight", "#070818", "#1b1e3a"),
    ];

    private readonly MarkerStyle brandStyle = new() { Size = 14, TailLength = 22, TailCurve = 0.4, Glow = 0.5 };

    private WorldMap? map;
    private LocationEditor? editor;
    private IJSObjectReference? helpers;
    private List<TravelLocation> locations = [];
    private LocationDraft? draft;
    private MarkerStyle lastStyle = new();
    private MapSettings mapSettings = new();
    private MapTheme theme = MapTheme.Light;
    private Guid? selectedId;
    private bool loaded;
    private bool panelOpen = true;
    private bool pickMode;
    private ExportBar.ExportPreset? exportPreset;
    private bool exporting;
    private string? exportMessage;

    private string Summary
    {
        get
        {
            if (!loaded) return "Places lived & visited";
            var lived = locations.Count(l => l.Kind == VisitKind.Lived);
            var visited = locations.Count - lived;
            return locations.Count == 0
                ? "Places lived & visited"
                : $"{lived} lived · {visited} visited";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        helpers = await JS.InvokeAsync<IJSObjectReference>("import", "./js/atlas.js");
        var themeKey = await helpers.InvokeAsync<string>("getTheme");
        theme = Enum.TryParse<MapTheme>(themeKey, ignoreCase: true, out var t) ? t : MapTheme.Light;

        locations = await Store.LoadAsync();
        lastStyle = await Store.LoadLastStyleAsync() ?? new MarkerStyle();
        mapSettings = await Store.LoadMapSettingsAsync();
        loaded = true;
    }

    private async Task SaveMapSettingsAsync(MapSettings settings)
    {
        if (settings.MarkerZoom < 0)
        {
            // Lock marker sizes to how they look right now.
            settings.MarkerZoom = map is null ? 2.5 : Math.Round(await map.GetZoomAsync(), 2);
        }

        mapSettings = settings;
        await Store.SaveMapSettingsAsync(settings);
    }

    private async Task SetThemeAsync(MapTheme value)
    {
        theme = value;
        if (helpers is not null)
        {
            await helpers.InvokeVoidAsync("setTheme", WorldMap.ThemeKey(value));
        }
    }

    private void TogglePanel() => panelOpen = !panelOpen;

    private async Task StartExportAsync()
    {
        pickMode = false;
        exportMessage = null;
        exportPreset ??= ExportBar.Presets[0];
        StateHasChanged();
        if (map is not null)
        {
            await map.StartExportAsync(exportPreset.Aspect, mapSettings.ExportCenterLongitude);
            if (locations.Count > 0)
            {
                await map.FitToExportFrameAsync();
            }
        }
    }

    private async Task ChangeExportPresetAsync(ExportBar.ExportPreset preset)
    {
        exportPreset = preset;
        exportMessage = null;
        if (map is not null)
        {
            await map.StartExportAsync(preset.Aspect, mapSettings.ExportCenterLongitude);
            if (locations.Count > 0)
            {
                await map.FitToExportFrameAsync();
            }
        }
    }

    private async Task ChangeExportCenterAsync(double longitude)
    {
        var settings = mapSettings.Clone();
        settings.ExportCenterLongitude = Math.Clamp(longitude, -180, 180);
        await SaveMapSettingsAsync(settings);
        if (map is not null)
        {
            await map.SetExportCenterAsync(settings.ExportCenterLongitude);
            if (locations.Count > 0)
            {
                await map.FitToExportFrameAsync();
            }
        }
    }

    private Task FitExportAsync() => map?.FitToExportFrameAsync() ?? Task.CompletedTask;

    private async Task DownloadPngAsync()
    {
        if (map is null || exportPreset is null) return;
        exporting = true;
        exportMessage = null;
        StateHasChanged();
        try
        {
            exportMessage = await map.ExportPngAsync(exportPreset.Width, exportPreset.Height,
                $"katrinas-atlas-{exportPreset.FileSuffix}.png");
        }
        catch (JSException ex)
        {
            exportMessage = $"Sorry, the image couldn't be saved: {ex.Message}";
        }
        finally
        {
            exporting = false;
        }
    }

    private async Task EndExportAsync()
    {
        exportPreset = null;
        exportMessage = null;
        if (map is not null)
        {
            await map.EndExportAsync();
        }
    }

    private void StartAdd()
    {
        selectedId = null;
        pickMode = false;
        draft = new LocationDraft { Style = lastStyle.Clone() };
    }

    private async Task StartEdit(TravelLocation location)
    {
        selectedId = location.Id;
        pickMode = false;
        draft = LocationDraft.FromLocation(location);
        await FlyToAsync(new GeoPoint(location.Latitude, location.Longitude));
    }

    private void CancelDraft()
    {
        draft = null;
        pickMode = false;
    }

    private async Task SaveDraftAsync()
    {
        if (draft is not { Latitude: { } lat, Longitude: { } lng }) return;

        var location = draft.EditingId is { } id ? locations.FirstOrDefault(l => l.Id == id) : null;
        if (location is null)
        {
            location = new TravelLocation();
            locations.Add(location);
        }

        location.Name = draft.Name;
        location.Latitude = lat;
        location.Longitude = lng;
        location.Kind = draft.Kind;
        location.Style = draft.Style.Clone();
        location.Label = draft.Label.Trim();
        location.LabelPosition = draft.LabelPosition;
        lastStyle = draft.Style.Clone();

        draft = null;
        pickMode = false;
        selectedId = location.Id;

        await Store.SaveAsync(locations);
        await Store.SaveLastStyleAsync(lastStyle);
        await ScrollToSelectedAsync();
    }

    private async Task DeleteDraftAsync()
    {
        if (draft?.EditingId is { } id && locations.FirstOrDefault(l => l.Id == id) is { } location)
        {
            if (await DeleteAsync(location))
            {
                draft = null;
                pickMode = false;
            }
        }
    }

    private async Task<bool> DeleteAsync(TravelLocation location)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Remove \"{location.Name}\" from the map?"))
        {
            return false;
        }

        locations.Remove(location);
        if (selectedId == location.Id) selectedId = null;
        await Store.SaveAsync(locations);
        return true;
    }

    private async Task SelectAsync(TravelLocation location)
    {
        selectedId = location.Id;
        await FlyToAsync(new GeoPoint(location.Latitude, location.Longitude));
    }

    private async Task HandleMarkerClickAsync(Guid id)
    {
        if (draft is not null) return;
        selectedId = id;
        panelOpen = true;
        StateHasChanged();
        await ScrollToSelectedAsync();
    }

    private async Task HandleMapClickAsync(GeoPoint point)
    {
        if (!pickMode || editor is null) return;
        pickMode = false;
        await editor.SetPositionFromMapAsync(point);
    }

    private async Task HandleDraftMovedAsync(GeoPoint point)
    {
        if (editor is not null)
        {
            await editor.SetPositionFromMapAsync(point);
        }
    }

    private async Task FlyToAsync(GeoPoint point)
    {
        if (map is not null)
        {
            await map.FlyToAsync(point.Latitude, point.Longitude);
        }
    }

    private Task FitAllAsync() => map?.FitToLocationsAsync() ?? Task.CompletedTask;

    private async Task ScrollToSelectedAsync()
    {
        if (helpers is not null && selectedId is { } id)
        {
            await Task.Yield();
            await helpers.InvokeVoidAsync("scrollIntoView", $"loc-{id:N}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (helpers is not null)
        {
            try { await helpers.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}
